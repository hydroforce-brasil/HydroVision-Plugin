{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"HydroVision analysis delivery context",
  "type":"object",
  "required":["version","title","profile","generated_at","scope","period","method","coverage","warnings","entities","metrics","evidence"],
  "additionalProperties":false,
  "properties":{
    "version":{"const":"1.0.0"},
    "title":{"type":"string","minLength":1},
    "profile":{"enum":["management","technical"]},
    "generated_at":{"type":"string","format":"date-time"},
    "template_id":{"type":["string","null"]},
    "scope":{"$ref":"#/$defs/scope"},
    "period":{"$ref":"#/$defs/period"},
    "method":{"type":"object"},
    "coverage":{"type":"object"},
    "warnings":{"type":"array","items":{"type":"string"}},
    "entities":{"type":"array","items":{"type":"object","required":["concept_id","id","label"],"properties":{"concept_id":{"type":"string","minLength":1},"id":{"type":["integer","string"]},"label":{"type":"string","minLength":1}}}},
    "metrics":{"type":"array","items":{"type":"object","required":["id","label","value","unit","source_tool","scope","period","coverage"],"properties":{"id":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"value":{"type":["number","null"]},"unit":{"type":"string","minLength":1},"source_tool":{"type":"string","minLength":1},"scope":{"$ref":"#/$defs/scope"},"period":{"$ref":"#/$defs/period"},"coverage":{"type":"object"}}}},
    "evidence":{"type":"array","items":{"type":"object","required":["id","entity_type","entity_id","caption","source_tool","status","placement"],"properties":{"id":{"type":"string","minLength":1},"entity_type":{"type":"string","minLength":1},"entity_id":{"type":["integer","string"]},"caption":{"type":"string","minLength":1},"source_tool":{"type":"string","minLength":1},"source_record_id":{"type":["integer","string","null"]},"status":{"enum":["available","unavailable"]},"placement":{"enum":["body","appendix"]},"image_path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reason":{"type":"string","minLength":1}}}},
    "visualizations":{"type":"array","items":{"type":"object","required":["view_id","title","source_tools"],"properties":{"view_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"source_tools":{"type":"array","items":{"type":"string"},"minItems":1}}}}
  },
  "$defs":{
    "scope":{"type":"object","required":["company_ids"],"properties":{"company_ids":{"type":"array","items":{"type":"integer","minimum":1},"minItems":1,"uniqueItems":true},"company_names":{"type":"array","items":{"type":"string"}},"sector_ids":{"type":"array","items":{"type":"integer","minimum":1},"uniqueItems":true},"complete":{"type":"boolean"},"notes":{"type":"string"}}},
    "period":{"type":["object","null"],"required":["start","end","basis","timezone"],"properties":{"start":{"type":"string","minLength":1},"end":{"type":"string","minLength":1},"basis":{"type":"string","minLength":1},"timezone":{"type":"string","minLength":1}}}
  }
}
